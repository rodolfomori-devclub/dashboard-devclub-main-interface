# Railpack automatically uses a root Caddyfile for this Vite SPA.
{
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}
	servers {
		trusted_proxies static private_ranges 100.0.0.0/8
	}
}

:{$PORT:80} {
	log {
		format json
	}
	root * /app/dist
	encode gzip zstd
	respond /health 200
	# Canonical and legacy public TV addresses share privacy/cache headers.
	@publicTv path /tv /tv/*
	@publicTvLight path /tv-light /tv-light/*
	@tvVisits path /tv /tv/* /tv-light /tv-light/*
	log_skip @tvVisits

	header {
		X-Content-Type-Options "nosniff"
		-Server
	}

	# A missing bundle must never receive the SPA HTML or an immutable cache header.
	handle /assets/* {
		@versioned {
			path_regexp versioned ^/assets/.+-[A-Za-z0-9_-]{8,}\.[^/]+$
			file {path}
		}
		route {
			header Cache-Control "no-cache, max-age=0, must-revalidate"
			header @versioned Cache-Control "public, max-age=31536000, immutable"
			file_server {
				hide .git .env*
			}
		}
	}

	# TV Light is a separate HTML document, runnable without ES modules/React.
	@tvLightAssets path /tv-light/*.js /tv-light/*.css
	handle @tvLightAssets {
		header Cache-Control "no-store"
		header Referrer-Policy "no-referrer"
		header X-Robots-Tag "noindex, nofollow, noarchive"
		file_server
	}
	handle @publicTvLight {
		header Cache-Control "no-store"
		header Referrer-Policy "no-referrer"
		header X-Robots-Tag "noindex, nofollow, noarchive"
		rewrite * /tv-light/index.html
		file_server
	}

	# Keep ETag revalidation for HTML, including direct routes and OAuth callback.
	handle @publicTv {
		header Cache-Control "no-store"
		header Referrer-Policy "no-referrer"
		header X-Robots-Tag "noindex, nofollow, noarchive"
		rewrite * /index.html
		file_server
	}

	handle {
		header Cache-Control "no-cache, max-age=0, must-revalidate"
		try_files {path} {path}.html {path}/index.html /index.html
		file_server {
			hide .git .env*
		}
	}

	handle_errors {
		header Cache-Control "no-store"
		header X-Content-Type-Options "nosniff"
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
